[
  {
    "id": "row-1-syncing",
    "group": "next-step-rows",
    "title": "the app's sync runs: nothing starts until it ends; bd runs its own sync first",
    "spec": ["openspec/specs/branch/next-step/spec.md#the-table:1", "openspec/specs/cli/agent-cli/spec.md#brd-safe-push"],
    "given": {
      "sync": "running"
    },
    "expect": {
      "step": {
        "row": "1",
        "kind": "settled",
        "safePush": "syncing",
        "dryRun": "syncing"
      },
      "land": {
        "start": "api",
        "pushes": ["auth"]
      }
    },
    "asymmetry": {
      "kind": "byDesign",
      "why": "bd syncs under the repository lock before it plans (openspec/specs/cli/agent-cli/spec.md#brd-safe-push): a sync of the app is no state of bd"
    },
    "bd": {
      "step": {
        "row": "11",
        "kind": "safePush"
      }
    }
  },
  {
    "id": "row-1-sync-failed",
