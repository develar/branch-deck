  {
    "id": "pull-request-comment-takes-no-profile",
    "group": "modes-and-routes",
    "title": "a profile chosen for a start from a pull request comment",
    "spec": ["spec/branch/patronus.spec.md#starting-a-safe-push-or-a-dry-run", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {
      "pullRequest": {},
      "profile": {
        "chosen": "lsc"
      }
    },
    "expect": {
      "step": {
        "row": "11",
        "kind": "safePush"
      },
      "land": {
        "start": "comment:7",
        "pushes": ["auth"]
      }
    },
    "asymmetry": {
      "kind": "byDesign",
      "why": "a /patronus comment can't choose a profile: the app's popover offers none for it and starts the default checks, bd refuses --profile (agent-cli.spec.md, bd safe-push)"
    },
    "bd": {
      "error": "invalid_arguments"
    }
  },
  {
