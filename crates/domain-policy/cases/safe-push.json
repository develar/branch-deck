[
  {
    "id": "safe-push-via-api",
    "group": "modes-and-routes",
    "title": "a Safe Push of a lone branch without a pull request starts through the API",
    "spec": ["spec/branch/patronus.spec.md#starting-a-safe-push-or-a-dry-run", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {},
    "expect": {
      "step": {
        "row": "11",
        "kind": "safePush"
      },
      "land": {
        "start": "api",
        "pushes": ["auth"]
      }
    }
  },
  {
    "id": "dry-run-via-api",
    "group": "modes-and-routes",
    "title": "a Dry Run of a lone branch starts through the API, the review not checked",
    "spec": ["spec/branch/patronus.spec.md#starting-a-safe-push-or-a-dry-run", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {
      "mode": "dryRun"
    },
    "expect": {
      "step": {
        "row": "11",
        "kind": "safePush"
      },
      "land": {
        "start": "api",
        "pushes": ["auth"]
      }
    },
    "asymmetry": {
      "kind": "byDesign",
      "why": "bd asks Patronus for the review only when the start waits for it, never for a Dry Run, so the step of --check waits for it: spec/cli/agent-cli.spec.md#bd-safe-push"
    },
    "bd": {
      "step": {
        "row": "0",
        "kind": "pending",
        "safePush": "step"
      }
    }
  },
