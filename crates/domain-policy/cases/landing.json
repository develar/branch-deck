  {
    "id": "whole-stack-holds-a-parked-member",
    "group": "landing",
    "title": "session of the forking auth stack is parked: the whole stack holds what is parked and stays local",
    "spec": [
      "spec/branch/parked-branches.spec.md#parked-with-a-parent",
      "spec/branch/stacked-branches.spec.md",
      "spec/branch/whole-stack.spec.md#the-safe-push-of-the-whole-stack",
      "spec/cli/agent-cli.spec.md#bd-safe-push"
    ],
    "given": {
      "commits": ["(auth) Add auth", "(auth/login) Add login", "(auth/session) Add session"],
      "subject": "wholeStack",
      "parked": "session"
    },
    "expect": {
      "step": {
        "row": "1",
        "kind": "settled",
        "safePush": "stackParked",
        "dryRun": "stackParked"
      },
      "land": {
        "blockers": ["stackParked"],
        "confirmations": ["landsMoreThanRow"],
        "start": "api",
        "lands": ["auth", "login", "session"]
      }
    },
    "asymmetry": {
      "kind": "byDesign",
      "why": "what the table alone refuses fails the command before Patronus or GitHub is asked: spec/cli/agent-cli.spec.md#bd-safe-push"
    },
    "bd": {
      "error": "parked"
    }
  },
  {
    "id": "remote-behind",
    "group": "landing",
    "title": "the remote branch has a commit of someone else that the branch lacks: a push would drop it, so the step takes it in first",
    "spec": ["spec/branch/patronus.spec.md#pushing-into-a-branch-whose-safe-push-runs", "spec/cli/agent-cli.spec.md#bd-safe-push", "spec/branch/next-step.spec.md#the-table:1″"],
    "given": {
      "remote": "behind"
    },
    "expect": {
      "step": {
        "row": "1″",
        "kind": "pickRemoteCommits"
      },
      "land": {
        "blockers": ["dropsRemote"],
        "start": "api"
      }
    }
  },
  {
    "id": "retarget-of-a-pushed-along-ancestor",
    "group": "landing",
    "title": "the Safe Push of session pushes login along, whose pull request #7 goes into the virtual branch of auth: bd retargets it to master first",
    "spec": ["spec/branch/patronus.spec.md#pull-requests", "spec/branch/stacked-branches.spec.md#pull-requests", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {
      "commits": ["(auth) Add auth", "(auth/login) Add login", "(login/session) Add session"],
      "branch": "session",
      "pullRequest": {
        "of": "login",
        "base": "test-user/virtual/auth"
      }
    },
    "expect": {
      "step": {
        "row": "11",
        "kind": "safePush"
      },
      "land": {
        "confirmations": ["landsMoreThanRow"],
        "start": "api",
        "pushes": ["auth", "login", "session"],
        "retargets": [7],
        "lands": ["auth", "login", "session"]
      }
    }
  },
