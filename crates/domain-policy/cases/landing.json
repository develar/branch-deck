[
  {
    "id": "robot-on-the-remote-branch-rebuilt-on-a-newer-baseline",
    "group": "landing",
    "title": "a Safe Push runs on the remote branch, which has the commits of the branch by content, rebuilt since on a newer baseline: a start would test the same commits again",
    "spec": [
      "spec/branch/patronus.spec.md#starting-a-safe-push-or-a-dry-run",
      "spec/branch/patronus.spec.md#pushing-into-a-branch-whose-safe-push-runs",
      "spec/cli/agent-cli.spec.md#bd-safe-push"
    ],
    "given": {
      "remote": "rebuiltOnNewerBaseline",
      "robot": {
        "state": "running",
        "on": "remote"
      }
    },
    "expect": {
      "step": {
        "row": "1",
        "kind": "settled",
        "safePush": "lastCommit",
        "dryRun": "lastCommit"
      },
      "land": {
        "blockers": ["lastCommit"],
        "confirmations": ["nonDefaultProfile"],
        "start": "api:lsc"
      }
    }
  },
  {
    "id": "rebuilt-on-a-newer-baseline-starts-without-a-push",
    "group": "landing",
    "title": "the remote branch has the commits of the branch by content, only rebuilt since on a newer baseline: the start pushes nothing",
    "spec": ["spec/branch/patronus.spec.md#starting-a-safe-push-or-a-dry-run", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {
      "remote": "rebuiltOnNewerBaseline"
    },
    "expect": {
      "step": {
        "row": "11",
        "kind": "safePush"
      },
      "land": {
        "start": "api",
        "pushes": null
      }
    }
  },
  {
    "id": "robot-of-a-branch-built-on-it-before-the-ancestor",
    "group": "landing",
    "title": "a Safe Push of session, built on login, lands login, while one of auth lands a part of it: the reason names session first",
    "spec": ["spec/branch/patronus.spec.md#starting-a-safe-push-or-a-dry-run", "spec/branch/next-step.spec.md#the-table", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {
      "commits": ["(auth) Add auth", "(auth/login) Add login", "(login/session) Add session"],
      "branch": "login",
      "robot": [
        {
          "state": "running",
          "on": "child:session"
        },
        {
          "state": "running",
          "on": "ancestor:auth"
        }
      ]
    },
    "expect": {
      "step": {
        "row": "1",
        "kind": "settled",
        "safePush": "descendant",
        "dryRun": "held"
      },
      "land": {
        "blockers": ["descendant"],
        "confirmations": ["landsMoreThanRow"],
        "start": "api",
        "lands": ["auth", "login"]
      }
    }
  },
  {
    "id": "older-robot-with-a-push-needed",
    "group": "landing",
    "title": "a Safe Push of an older commit runs and the branch has a commit the remote lacks: the push fails it at the end",
    "spec": [
      "spec/branch/patronus.spec.md#restart-and-cancel",
      "spec/branch/patronus.spec.md#pushing-into-a-branch-whose-safe-push-runs",
      "spec/cli/agent-cli.spec.md#bd-safe-push"
    ],
    "given": {
      "remote": "unpushed",
      "robot": {
        "state": "running",
        "on": "older"
      }
    },
    "expect": {
      "step": {
        "row": "1",
        "kind": "settled"
      },
      "land": {
        "confirmations": ["cancelsRobot"],
        "start": "api",
        "pushes": ["auth"],
        "cancels": "older"
      }
    }
  },
  {
