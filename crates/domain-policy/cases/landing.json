        "pushes": ["auth"],
        "cancels": "older"
      }
    }
  },
  {
    "id": "older-robot-without-a-push",
    "group": "landing",
    "title": "a Safe Push of an older commit runs and the remote branch is up to date: a start would run beside it",
    "spec": ["spec/branch/patronus.spec.md#restart-and-cancel", "spec/cli/agent-cli.spec.md#bd-safe-push"],
    "given": {
