[
  {
    "id": "push-to-master-of-a-piece",
    "group": "modes-and-routes",
    "title": "a repository that lands by a push: a lone branch is pushed into master as its copy, what CI did not check accepted",
    "spec": ["spec/branch/landing-routes.spec.md#push-to-master", "spec/branch/next-step.spec.md#the-table:push", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "push",
      "flags": ["withoutChecks"]
    },
    "expect": {
      "step": {
        "row": "push",
        "kind": "pushToBaseline",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "confirmations": ["unchecked"],
        "into": "master",
        "lands": ["auth"]
      }
    }
  },
  {
    "id": "push-to-master-of-a-stacked-piece-asks-for-the-checks",
    "group": "modes-and-routes",
    "title": "a repository that lands by a push: a stacked branch lands what it is built on, and the push waits for the user to accept what CI did not check",
    "spec": ["spec/branch/landing-routes.spec.md#push-to-master", "spec/branch/next-step.spec.md#a-push-into-the-target", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "push",
      "branch": "login",
      "commits": ["(auth) Add auth", "(auth/login) Add login"]
    },
    "expect": {
      "step": {
        "row": "push",
        "kind": "pushToBaseline",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "confirmations": ["landsMoreThanRow", "unchecked"],
        "into": "master",
        "lands": ["auth", "login"]
      }
    }
  },
  {
    "id": "push-to-master-of-the-whole-stack",
    "group": "modes-and-routes",
    "title": "a repository that lands by a push: the whole stack of a stack that forks is pushed into master as its stack branch",
    "spec": ["spec/branch/landing-routes.spec.md#push-to-master", "spec/branch/next-step.spec.md#a-push-into-the-target", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "push",
      "commits": ["(auth) Add auth", "(auth/login) Add login", "(auth/session) Add session"],
      "subject": "wholeStack",
      "flags": ["withoutChecks"]
    },
    "expect": {
      "step": {
        "row": "push",
        "kind": "pushToBaseline",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "confirmations": ["landsMoreThanRow", "unchecked"],
        "into": "master",
        "lands": ["auth", "login", "session"]
      }
    }
  },
  {
    "id": "push-to-master-refused-below-write-access",
    "group": "modes-and-routes",
    "title": "a repository that lands by a push into a GitHub repository the token may only read: the gate of the route refuses the push",
    "spec": ["spec/branch/landing-routes.spec.md#gates", "spec/branch/landing-routes.spec.md#push-to-master", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "push",
      "permission": "read",
      "flags": ["withoutChecks"]
    },
    "expect": {
      "step": {
        "row": "push",
        "kind": "pushToBaseline",
        "safePush": "noWriteAccess",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "blockers": ["noWriteAccess"],
        "confirmations": ["unchecked"],
        "into": "master",
        "lands": ["auth"]
      }
    }
  },
  {
    "id": "push-to-master-asks-for-the-required-status-checks",
    "group": "modes-and-routes",
    "title": "a repository that lands by a push into a GitHub repository whose master requires status checks: the gate asks for them beside what CI did not check, and bd pushes nothing without --bypass-rules",
    "spec": ["spec/branch/landing-routes.spec.md#gates", "spec/branch/landing-routes.spec.md#push-to-master", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "push",
      "permission": "write",
      "rules": "statusChecks",
      "flags": ["withoutChecks"]
    },
    "expect": {
      "step": {
        "row": "push",
        "kind": "pushToBaseline",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "confirmations": ["unchecked", "routeRule"],
        "into": "master",
        "lands": ["auth"]
      }
    }
  },
  {
    "id": "push-to-master-after-a-fetch-updates-first",
    "group": "modes-and-routes",
    "title": "a repository that lands by a push whose fetched master has a commit the branch is not built on: the step is Update Project, and the push, which would be no fast-forward, is refused before it is sent",
    "spec": ["spec/branch/landing-routes.spec.md#gates", "spec/branch/next-step.spec.md#the-table:push′", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "push",
      "baselineAhead": true,
      "flags": ["withoutChecks"]
    },
    "expect": {
      "step": {
        "row": "push′",
        "kind": "updateProject",
        "safePush": "baselineAhead",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "blockers": ["baselineAhead"],
        "confirmations": ["unchecked"],
        "into": "master",
        "lands": ["auth"]
      }
    }
  },
  {
    "id": "merge-of-a-clean-pull-request",
    "group": "modes-and-routes",
    "title": "a repository that lands by a merge of the pull request: GitHub can merge it, so it merges by rebase on the commit the copy is",
    "spec": ["spec/branch/landing-routes.spec.md#merge", "spec/branch/next-step.spec.md#the-table:merge", "spec/cli/agent-cli.spec.md#bd-land"],
    "given": {
      "route": "pullRequest",
      "notOnSpace": true,
      "readiness": "notAsked",
      "pullRequest": {
        "mergeState": "CLEAN"
      }
    },
    "expect": {
      "step": {
        "row": "merge",
        "kind": "mergePullRequest",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "lands": ["auth"],
        "merges": "merge:7"
      }
    }
  },
  {
    "id": "auto-merge-while-the-required-checks-run",
    "group": "modes-and-routes",
    "title": "a repository that lands by a merge of the pull request: its required checks still run, so GitHub merges it once they pass",
    "spec": ["spec/branch/landing-routes.spec.md#merge", "spec/cli/agent-cli.spec.md#bd-land", "spec/branch/next-step.spec.md#the-table:merge"],
    "given": {
      "route": "pullRequest",
      "notOnSpace": true,
      "readiness": "notAsked",
      "pullRequest": {
        "mergeState": "BLOCKED",
        "checksRunning": true
      }
    },
    "expect": {
      "step": {
        "row": "merge",
        "kind": "mergePullRequest",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "lands": ["auth"],
        "merges": "autoMerge:7"
      }
    }
  },
  {
    "id": "auto-merge-enabled",
    "group": "modes-and-routes",
    "title": "a repository that lands by a merge of the pull request: its auto-merge is enabled, GitHub merges it by itself, nothing starts",
    "spec": ["spec/branch/landing-routes.spec.md#merge", "spec/cli/agent-cli.spec.md#bd-land", "spec/branch/next-step.spec.md#the-table:merge′"],
    "given": {
      "route": "pullRequest",
      "notOnSpace": true,
      "readiness": "notAsked",
      "pullRequest": {
        "mergeState": "BLOCKED",
        "checksRunning": true,
        "autoMerge": true
      }
    },
    "expect": {
      "step": {
        "row": "merge′",
        "kind": "autoMerging",
        "safePush": "step",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "lands": ["auth"]
      }
    }
  },
  {
    "id": "merge-held-for-approvals",
    "group": "modes-and-routes",
    "title": "a repository that lands by a merge of the pull request: its base requires approvals it lacks, so the merge waits for them",
    "spec": ["spec/branch/landing-routes.spec.md#merge", "spec/cli/agent-cli.spec.md#bd-land", "spec/branch/next-step.spec.md#the-table:merge″"],
    "given": {
      "route": "pullRequest",
      "notOnSpace": true,
      "readiness": "notAsked",
      "pullRequest": {
        "mergeState": "BLOCKED",
        "reviewDecision": "REVIEW_REQUIRED"
      }
    },
    "expect": {
      "step": {
        "row": "merge″",
        "kind": "mergeHeld",
        "safePush": "mergeNeedsApprovals",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "blockers": ["mergeNeedsApprovals"],
        "lands": ["auth"]
      }
    }
  },
  {
    "id": "merge-without-a-pull-request",
    "group": "modes-and-routes",
    "title": "a repository that lands by a merge of the pull request: the branch has none, so Create Pull Request comes first",
    "spec": ["spec/branch/landing-routes.spec.md#merge", "spec/cli/agent-cli.spec.md#bd-land", "spec/branch/next-step.spec.md#the-table:pr"],
    "given": {
      "route": "pullRequest",
      "notOnSpace": true,
      "readiness": "notAsked"
    },
    "expect": {
      "step": {
        "row": "pr",
        "kind": "openPullRequest",
        "safePush": "noPullRequestToMerge",
        "dryRun": "dryRunNeedsPatronus"
      },
      "land": {
        "blockers": ["noPullRequestToMerge"],
        "lands": ["auth"]
      }
    }
  }
]
