{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sub-windows",
  "description": "Capability for all sub-windows (missing commits, conflicting files, etc.)",
  "windows": [
    "missing-commits",
    "conflicting-files"
  ],
  "permissions": [
    "core:event:default",
    "window-state:default",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    "store:default",
    "log:default"
  ]
}