{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sub-windows",
  "description": "Capability for all sub-windows (missing commits, conflicting files, branch review)",
  "windows": [
    "missing-commits",
    "conflicting-files",
    "branch-review"
  ],
  "permissions": [
    "core:event:default",
    "window-state:default",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    "store:default",
    "log:default",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}