{
  "identifier": "desktop-capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:window:allow-set-focus",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }, { "url": "ms-settings:*" }]
    }
  ]
}
