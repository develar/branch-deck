{"host":{"jsonrpc":"2.0","method":"action","params":{"channel":"x-branch-deck:/repository/1","action":{"type":"x-branch-deck/viewPatched","patch":{"base":"${view0.version}","next":"${v1}","changes":"${any}"}},"window":"review-1","serverSeq":1}},"conn":1}
{"host":{"jsonrpc":"2.0","method":"action","params":{"channel":"x-branch-deck:/repository/1","action":{"type":"x-branch-deck/viewPatched","patch":{"base":"${view0.version}","next":"${v1}","changes":"${any}"}},"window":"mirror:${repo}","serverSeq":1}},"conn":2}
{"host":{"jsonrpc":"2.0","id":8,"result":{"value":{"outcome":"synced","version":"${v1}"}}},"conn":1}
{"comment":"The channel takes no intent: the echo rejects it, and the view keeps its version."}
{"client":{"jsonrpc":"2.0","method":"dispatchAction","params":{"channel":"x-branch-deck:/repository/1","clientSeq":1,"action":{"type":"x-branch-deck/sync"}}},"conn":2}
{"host":{"jsonrpc":"2.0","method":"action","params":{"channel":"x-branch-deck:/repository/1","serverSeq":2,"action":{"type":"x-branch-deck/sync"},"origin":{"clientId":"corpus-2","clientSeq":1},"rejectionReason":"unknownAction"}},"conn":2}
{"comment":"A subscribe with the seed after the session moved: held, and the first action of the window is the catch-up the session builds from the seed. The bridge leaves and comes back with the version it held before the sync."}
{"client":{"jsonrpc":"2.0","id":4,"method":"unsubscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"mirror:${repo}"}}}},"conn":2}
{"host":{"jsonrpc":"2.0","id":4,"result":{}},"conn":2}
{"client":{"jsonrpc":"2.0","id":5,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"mirror:${repo}","have":"${view0.version}"}}}},"conn":2}
{"host":{"jsonrpc":"2.0","id":5,"result":{"snapshot":{"resource":"x-branch-deck:/repository/1","fromSeq":2,"_meta":{"x-branch-deck":{"held":"${view0.version}"}}}}},"conn":2}
{"host":{"jsonrpc":"2.0","method":"action","params":{"channel":"x-branch-deck:/repository/1","action":{"type":"x-branch-deck/viewPatched","patch":{"base":"${view0.version}","next":"${v1}","changes":"${any}"}},"window":"mirror:${repo}","serverSeq":3}},"conn":2}
{"comment":"Another epoch: the prefix of the fixture changes, and the main window subscribes again. The channel moves to the session of the new prefix: each other subscribed window gets one resync whose version is of another epoch than ${v1}, the main window its snapshot."}
{"step":"setPrefix","value":"corpus-other"}
{"client":{"jsonrpc":"2.0","id":9,"method":"unsubscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"main"}}}},"conn":1}
{"host":{"jsonrpc":"2.0","id":9,"result":{}},"conn":1}
{"client":{"jsonrpc":"2.0","id":10,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"main"}}}},"conn":1}
{"host":{"jsonrpc":"2.0","method":"x-branch-deck/resync","params":{"channel":"x-branch-deck:/repository/1","window":"review-1","snapshot":{"resource":"x-branch-deck:/repository/1","state":"${view2}","fromSeq":4}}},"conn":1}
{"host":{"jsonrpc":"2.0","id":10,"result":{"snapshot":{"resource":"x-branch-deck:/repository/1","state":"${view2}","fromSeq":4}}},"conn":1}
{"host":{"jsonrpc":"2.0","method":"x-branch-deck/resync","params":{"channel":"x-branch-deck:/repository/1","window":"mirror:${repo}","snapshot":{"resource":"x-branch-deck:/repository/1","state":"${view2}","fromSeq":4}}},"conn":2}
