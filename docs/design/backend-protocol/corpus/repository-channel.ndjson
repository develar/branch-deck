{"host":{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"1.0.0","serverSeq":0,"snapshots":[],"serverInfo":{"name":"branch-deck","build":"${build}"},"_meta":{"x-branch-deck":{"version":"1.0.0"}}}},"conn":2}
{"comment":"The channel of a path is one URI for the life of the backend, for every connection."}
{"client":{"jsonrpc":"2.0","id":2,"method":"x-branch-deck/repositoryChannel","params":{"channel":"ahp-root://","repositoryPath":"${repo}"}},"conn":1}
{"host":{"jsonrpc":"2.0","id":2,"result":{"channel":"x-branch-deck:/repository/1"}},"conn":1}
{"client":{"jsonrpc":"2.0","id":2,"method":"x-branch-deck/repositoryChannel","params":{"channel":"ahp-root://","repositoryPath":"${repo}"}},"conn":2}
{"host":{"jsonrpc":"2.0","id":2,"result":{"channel":"x-branch-deck:/repository/1"}},"conn":2}
{"comment":"A subscribe without have: the snapshot holds the view of the session, with its version. A second subscribe of the same window is refused; another window of the same connection subscribes on its own; a subscribe that names no window is badParams."}
{"client":{"jsonrpc":"2.0","id":3,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"main"}}}},"conn":1}
{"host":{"jsonrpc":"2.0","id":3,"result":{"snapshot":{"resource":"x-branch-deck:/repository/1","state":"${view0}","fromSeq":0}}},"conn":1}
{"client":{"jsonrpc":"2.0","id":4,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"main"}}}},"conn":1}
{"host":{"jsonrpc":"2.0","id":4,"error":{"code":-32011,"message":"${any}","data":{"reason":"alreadySubscribed"}}},"conn":1}
{"client":{"jsonrpc":"2.0","id":5,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"review-1"}}}},"conn":1}
{"host":{"jsonrpc":"2.0","id":5,"result":{"snapshot":{"resource":"x-branch-deck:/repository/1","state":"${view0}","fromSeq":0}}},"conn":1}
{"client":{"jsonrpc":"2.0","id":6,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1"}},"conn":1,"invalid":true}
{"host":{"jsonrpc":"2.0","id":6,"error":{"code":-32602,"message":"${any}","data":{"reason":"badParams"}}},"conn":1}
{"comment":"The bridge subscribes its mirror window with the version it holds: held, and no catch-up action, as the session did not move."}
{"client":{"jsonrpc":"2.0","id":3,"method":"subscribe","params":{"channel":"x-branch-deck:/repository/1","_meta":{"x-branch-deck":{"window":"mirror:${repo}","have":"${view0.version}"}}}},"conn":2}
{"host":{"jsonrpc":"2.0","id":3,"result":{"snapshot":{"resource":"x-branch-deck:/repository/1","fromSeq":0,"_meta":{"x-branch-deck":{"held":"${view0.version}"}}}}},"conn":2}
{"comment":"The demand of a window is the demand of its subscription; the session reads the facts of the union of its subscriptions."}
{"client":{"jsonrpc":"2.0","id":7,"method":"x-branch-deck/setDemand","params":{"channel":"x-branch-deck:/repository/1","window":"main","demand":{"focused":true,"online":true,"visibleBranches":[],"visibleStacks":[],"needed":[],"robotDetails":[],"watchedRobots":[]}}},"conn":1}
{"host":{"jsonrpc":"2.0","id":7,"result":{}},"conn":1}
{"comment":"A sync of the main window: one viewPatched to each subscribed window, all with one serverSeq, then the answer of the sync, which names the version it brought, after the frames of its connection (the version fence)."}
{"client":{"jsonrpc":"2.0","id":8,"method":"x-branch-deck/sync","params":{"channel":"ahp-root://","window":"main","args":{"params":{"repositoryPath":"${repo}","reason":"manual"}}}},"conn":1}
