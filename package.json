{
  "name": "branch-deck",
  "version": "0.28.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "test:backend": "cargo nextest run --workspace",
    "test:unit": "vp test run",
    "setup:e2e": "playwright install --with-deps",
    "e2e:check-browsers": "playwright install --dry-run || playwright install",
    "pree2e": "pnpm e2e:check-browsers",
    "e2e": "playwright test",
    "pree2e-up": "pnpm e2e:check-browsers",
    "e2e-up": "playwright test --update-snapshots",
    "e2e:webkit": "playwright test -c playwright.webkit.config.ts",
    "test": "pnpm run \"/^test:.*/\"",
    "tauri": "tauri",
    "install-app": "scripts/install-app.sh",
    "test-server:dev": "watchexec -w Cargo.toml -w Cargo.lock -w crates/branch-integration -w crates/git-executor -w crates/git-ops -w crates/github -w crates/history-rewrite -w crates/patronus -w crates/sync-core -w crates/sync-test-utils -w crates/sync-types -w crates/sync-utils -w crates/test-server -w crates/test-utils -w crates/youtrack -r -- cargo run -p test-server",
    "lint:backend": "cargo fmt --all && cargo clippy --workspace --all-targets --features branch-deck/auto-update --allow-dirty --fix && cargo clippy --workspace --all-targets --features branch-deck/auto-update -- -D warnings",
    "lint:js": "vp check --fix",
    "lint:typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint:frontend": "pnpm run \"/^lint:(js|typecheck)$/\"",
    "lint:cpd": "jscpd",
    "lint:specs": "node scripts/check-spec-links.mjs",
    "perf:bd-rebuild": "node scripts/perf/bd-rebuild.mjs",
    "perf:monorepo": "node scripts/perf/monorepo.mjs",
    "perf:diff": "playwright test -c playwright.perf.config.ts diff-review",
    "perf:table": "playwright test -c playwright.perf.config.ts branch-table",
    "screenshots:readme": "playwright test -c playwright.screenshots.config.ts",
    "lint": "pnpm run \"/^lint:.*/\"",
    "update-deps": "pnpm update --latest '!oxc-transform-react' && cargo upgrade --incompatible && cargo update",
    "update-gh-deps": "actions-up"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-store": "2.5.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "inter-ui": "4.1.1",
    "lucide-react": "1.57.0",
    "p-debounce": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.5",
    "react-router": "8.4.0",
    "shadcn": "4.21.5",
    "shiki": "4.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "actions-up": "1.21.0",
    "esbuild": "0.28.2",
    "jscpd": "5.4.1",
    "oxc-transform-react": "0.152.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.14.0"
}
