{
  "name": "branch-deck",
  "private": true,
  "version": "0.14.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:backend": "cargo nextest run --workspace",
    "test:unit": "vitest run",
    "setup:e2e": "playwright install --with-deps",
    "e2e:check-browsers": "playwright install --dry-run || playwright install",
    "pree2e": "pnpm e2e:check-browsers",
    "e2e": "playwright test",
    "pree2e-up": "pnpm e2e:check-browsers",
    "e2e-up": "playwright test --update-snapshots",
    "test": "pnpm run \"/^test:.*/\"",
    "tauri": "tauri",
    "install-app": "scripts/install-app.sh",
    "test-server:dev": "watchexec -w Cargo.toml -w Cargo.lock -w crates/branch-integration -w crates/git-executor -w crates/git-ops -w crates/sync-core -w crates/sync-test-utils -w crates/sync-types -w crates/sync-utils -w crates/test-server -w crates/test-utils -r -- cargo run -p test-server",
    "lint:backend": "cargo fmt --all && cargo clippy --all --allow-dirty --fix",
    "lint:js": "eslint . --fix",
    "lint:typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint:frontend": "pnpm run \"/^lint:(js|typecheck)$/\"",
    "lint:cpd": "jscpd",
    "lint": "pnpm run \"/^lint:.*/\"",
    "update-deps": "pnpm update --latest && cargo upgrade --incompatible && cargo update",
    "update-gh-deps": "actions-up"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@pierre/diffs": "1.5.2",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-notification": "2.6.0",
    "@tauri-apps/plugin-opener": "2.7.1",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "inter-ui": "4.1.1",
    "lucide-react": "1.57.0",
    "p-debounce": "5.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.5",
    "react-router": "8.4.0",
    "shadcn": "4.21.5",
    "shiki": "4.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "actions-up": "1.21.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jscpd": "5.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
