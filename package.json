{
  "name": "branch-deck",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:backend": "cargo nextest run --workspace --exclude model-ai",
    "test-model-ai": "cargo nextest run -p model-ai --release",
    "test-model-ai-up": "INSTA_UPDATE=always cargo nextest run -p model-ai --release",
    "setup:e2e": "playwright install --with-deps",
    "e2e:check-browsers": "playwright install --dry-run || playwright install",
    "pree2e": "pnpm e2e:check-browsers",
    "e2e": "playwright test",
    "pree2e-up": "pnpm e2e:check-browsers",
    "e2e-up": "playwright test --update-snapshots",
    "e2e:regenerate": "cargo run --bin regenerate-templates -p test-server",
    "test": "pnpm run \"/^test:.*/\"",
    "tauri": "tauri",
    "test-server:dev": "watchexec -w Cargo.toml -w Cargo.lock -w crates/branch-integration -w crates/git-executor -w crates/git-ops -w crates/model-ai -w crates/model-core -w crates/sync-core -w crates/sync-test-utils -w crates/sync-types -w crates/test-server -w crates/test-utils -r -- cargo run -p test-server",
    "lint:backend": "cargo fmt --all && cargo clippy --all --allow-dirty --fix",
    "lint:js": "eslint . --fix",
    "lint:typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint:frontend": "pnpm run \"/^lint:(js|typecheck)$/\"",
    "lint": "pnpm run \"/^lint:.*/\"",
    "update-deps": "pnpm update --latest && cargo upgrade --incompatible && cargo update",
    "update-gh-deps": "actions-up"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@git-diff-view/react": "0.1.7",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-log": "2.10.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "p-debounce": "5.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.4",
    "react-router": "8.4.0",
    "shadcn": "4.21.4",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "actions-up": "1.21.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
